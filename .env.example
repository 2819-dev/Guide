DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_JWKS_URL=
# Guide production canonical URL (Cloudflare Pages @ guidelearning.org)
NEXT_PUBLIC_GUIDE_URL=https://guidelearning.org
NEXT_PUBLIC_SITE=guide
# Public Amud on Guide Pages (default if unset: https://guidelearning.org/amudsite)
NEXT_PUBLIC_AMUD_URL=https://guidelearning.org/amudsite

# --- Email (Zoho Mail = inbox; Resend = app / Neon Auth transactional) ---
# Domain mailboxes (hello@ / team@) live in Zoho Mail — not configured here.
# Neon Auth custom SMTP (Neon Console → Settings → Better Auth), not env vars:
#   Host smtp.resend.com | Port 465 | Username resend | Password = RESEND_API_KEY
#   Sender email noreply@guidelearning.org | Sender name Guide
#
# Cloudflare Pages secret (Production + Preview) for Guide app sends:
#   RESEND_API_KEY — required to actually send; From is hardcoded to
#                    Guide <noreply@guidelearning.org> (no RESEND_FROM_EMAIL).
# Verify domain in Resend (send.guidelearning.org / DKIM) — see docs/guidelearning-email-setup.md
# Without RESEND_API_KEY, invite UI + APIs still work; sends are stubbed in logs.
# RESEND_API_KEY=


