DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_JWKS_URL=
# Guide production canonical URL (Cloudflare Pages @ guidelearning.org)
NEXT_PUBLIC_GUIDE_URL=https://guidelearning.org
# Arcade Education product home (subdomain — not a Guide path mount)
NEXT_PUBLIC_ARCADE_URL=https://arcade-edu.guidelearning.org
# Shared with Arcade for launch token mint/exchange (HMAC HS256)
ARCADE_LAUNCH_JWT_SECRET=

# --- Email (Zoho Mail = inbox; Resend = app / Neon Auth transactional) ---
# Domain mailboxes (hello@ / team@) live in Zoho Mail — not configured here.
# Neon Auth custom SMTP (Neon Console → Settings → Better Auth), not env vars:
#   Host smtp.resend.com | Port 465 | Username resend | Password = RESEND_API_KEY
#   Sender email noreply@guidelearning.org | Sender name Guide
#
# Cloudflare Pages secret (Production + Preview) for Guide app sends:
#   RESEND_API_KEY — required to actually send; From is hardcoded to
#                    Guide <noreply@guidelearning.org> (no RESEND_FROM_EMAIL).
# Verify domain in Resend (send.guidelearning.org / DKIM) — see docs/guidelearning-email-setup.md
# Without RESEND_API_KEY, invite UI + APIs still work; sends are stubbed in logs.
# RESEND_API_KEY=



# --- Blitz payments (Stripe) — read at request time; all optional ---
# Without STRIPE_SECRET_KEY + at least one price id, Blitz shows
# "Payments aren't set up yet" and only free-upgrade codes / Official grants work.
# Cloudflare Pages → Settings → Variables and Secrets (Production + Preview).
# STRIPE_SECRET_KEY=            # sk_live_... or sk_test_... (or a restricted rk_ key)
# STRIPE_WEBHOOK_SECRET=        # whsec_... from the endpoint
#                               # https://guidelearning.org/api/blitz/billing/webhook
# Recurring Price ids (price_...) for each plan + billing period:
# STRIPE_PRICE_PLUS_MONTHLY=
# STRIPE_PRICE_PLUS_YEARLY=
# STRIPE_PRICE_ULTRA_MONTHLY=
# STRIPE_PRICE_ULTRA_YEARLY=

# Live chat: Guide Assistant uses Cloudflare Workers AI. On Cloudflare Pages it
# uses the AI binding in wrangler.toml (no key). For local dev, optionally:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=   (API token with Workers AI: Read)
# Without either, chats go straight to the Guide team in the Official panel.
